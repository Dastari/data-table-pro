{
  "name": "data-table-pro",
  "version": "0.1.0",
  "description": "Standalone shadcn-compatible data table components built on TanStack Table.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Dastari/data-table-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dastari/data-table-pro.git"
  },
  "bugs": {
    "url": "https://github.com/Dastari/data-table-pro/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "react",
    "shadcn",
    "tanstack-table",
    "data-table",
    "component-library"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuqs": "^2.8.9",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "shadcn": "^4.1.1",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "tw-animate-css": "^1.4.0"
  }
}
