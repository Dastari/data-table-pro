{
  "name": "data-table-pro",
  "version": "5.3.0",
  "description": "Reusable React data table library with shadcn, HeroUI, and The Gridcn adapters.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Dastari/data-table-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dastari/data-table-pro.git"
  },
  "bugs": {
    "url": "https://github.com/Dastari/data-table-pro/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.19"
  },
  "sideEffects": [
    "./styles.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "styles.css.d.ts"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./heroui": {
      "types": "./dist/heroui.d.ts",
      "import": "./dist/heroui.js"
    },
    "./heroui/virtual": {
      "types": "./dist/heroui-virtual.d.ts",
      "import": "./dist/heroui-virtual.js"
    },
    "./thegridcn": {
      "types": "./dist/thegridcn.d.ts",
      "import": "./dist/thegridcn.js"
    },
    "./thegridcn/virtual": {
      "types": "./dist/thegridcn-virtual.d.ts",
      "import": "./dist/thegridcn-virtual.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js"
    },
    "./url-state": {
      "types": "./dist/url-state.d.ts",
      "import": "./dist/url-state.js"
    },
    "./data-source": {
      "types": "./dist/data-source.d.ts",
      "import": "./dist/data-source.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./adapter/virtual": {
      "types": "./dist/adapter-virtual.d.ts",
      "import": "./dist/adapter-virtual.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "style": "./styles.css",
      "default": "./styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "bench": "playwright test --config benchmarks/playwright.config.ts",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "api:check": "node scripts/public-api-snapshot.mjs",
    "api:update": "node scripts/public-api-snapshot.mjs --update",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "demo:typecheck": "tsc -p demo/tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --environment jsdom",
    "test:browser": "playwright test",
    "test:consumer": "node scripts/test-packed-consumer.mjs",
    "test:coverage": "vitest run --environment jsdom --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "react",
    "shadcn",
    "heroui",
    "thegridcn",
    "tanstack-table",
    "data-table",
    "component-library"
  ],
  "peerDependencies": {
    "@heroui/styles": "^3.2.2",
    "nuqs": "^2.9.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependenciesMeta": {
    "@heroui/styles": {
      "optional": true
    },
    "nuqs": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "shadcn": "^4.17.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
