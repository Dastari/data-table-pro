{
  "name": "data-table-pro",
  "version": "2.0.1",
  "description": "Reusable React data table library with shadcn, HeroUI, and The Gridcn adapters.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Dastari/data-table-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dastari/data-table-pro.git"
  },
  "bugs": {
    "url": "https://github.com/Dastari/data-table-pro/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "sideEffects": [
    "./styles.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./heroui": {
      "types": "./dist/heroui.d.ts",
      "import": "./dist/heroui.js",
      "require": "./dist/heroui.cjs"
    },
    "./thegridcn": {
      "types": "./dist/thegridcn.d.ts",
      "import": "./dist/thegridcn.js",
      "require": "./dist/thegridcn.cjs"
    },
    "./url-state": {
      "types": "./dist/url-state.d.ts",
      "import": "./dist/url-state.js",
      "require": "./dist/url-state.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./styles.css": {
      "style": "./styles.css",
      "default": "./styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "demo:typecheck": "tsc -p demo/tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "prepare": "pnpm build",
    "test": "vitest run --environment jsdom",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "react",
    "shadcn",
    "heroui",
    "thegridcn",
    "tanstack-table",
    "data-table",
    "component-library"
  ],
  "peerDependencies": {
    "@heroui/styles": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@heroui/styles": {
      "optional": true
    }
  },
  "dependencies": {
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuqs": "^2.8.9",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "shadcn": "^4.1.1",
    "tailwindcss": "^4.2.4",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.3"
  }
}
